{
  "name": "maexsocial-local-pilot",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "pilot:build": "tsc -p tsconfig.pilot.json",
    "pilot:up": "node dist/pilot/ops/local/stack.js up",
    "pilot:down": "node dist/pilot/ops/local/stack.js down",
    "pilot:migrate": "node dist/pilot/scripts/pilot-db.js",
    "pilot:backup": "npm run pilot:build && node dist/pilot/ops/local/backup.js",
    "pilot:readiness": "node dist/pilot/ops/local/readiness.js",
    "pilot:stop-dispatch": "node dist/pilot/ops/local/dispatch-control.js stop",
    "pilot:reopen-dispatch": "node dist/pilot/ops/local/dispatch-control.js reopen",
    "pilot:dispatch-status": "node dist/pilot/ops/local/dispatch-control.js status",
    "pilot:expire-audit-event": "node dist/pilot/ops/local/audit-retention.js",
    "pilot:retire-dispatch-details": "node dist/pilot/ops/local/dispatch-retention.js",
    "pilot:restore": "npm run pilot:build && node dist/pilot/ops/local/restore.js",
    "pilot:restore-quarantine": "node dist/pilot/ops/local/recover.js",
    "pilot:test": "node --test --test-concurrency=1 dist/pilot/tests/pilot/*.test.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "oauth4webapi": "3.8.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "playwright": "1.65.1",
    "typescript": "7.0.2"
  }
}
